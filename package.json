{
  "name": "tech-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "A frontend-only tech news & podcast aggregator for GitHub Pages.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "dev": "npx --yes serve . -l 3000"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
